#include<iostream>
using namespace std;

class Node{
	public : 
	int data;
	Node* next; 
	
	Node(int val){
		data = val;
		next = NULL;
	}	
};

class List{
	public:
		Node* head;
		Node* tail;
		
	
		List() {
			head = NULL;
			tail = NULL;
		}
		
		void push_front(int val){
			Node* newNode = new Node(val); 
		    if(head == NULL){
		    	head = tail = newNode;
		    	return ; 
			}  
		else{
			newNode->next = head;
			head = newNode;
		}
	}
	
	void push_back(int val){
		Node* newNode = new Node(val); 
		
		if(head == NULL){
			head = tail = newNode;
			return;
		}
		else{
			tail->next = newNode;
			tail = newNode;
		}
	}
	
	void pop_front(){
		if(head == NULL){
			return;
		} else {
			Node* temp = head;
			head = head->next; 
			temp->next = NULL;
			delete temp;
		}
	}
	
	void pop_back(){
		
		if(head == NULL){
			return;
		}
		
		if( head == tail ){
			delete head;
			head = tail = NULL;
			return;
		}
		
		Node* temp = head;
		while(temp->next != tail){
			temp = temp->next; 
		}
		delete tail;
		tail = temp;
		tail->next = NULL;	
	}
	
	void pop_middle(int pos){
		Node* temp = head; 
		
		if( head == nullptr || pos <= 0 ) return;
		for(int i = 1 ; i < pos - 1; i++) {
			if(temp == nullptr) 	break;
			temp = temp->next;
		}
		Node* wanted = temp->next;
		temp->next = wanted->next;
		delete wanted;
	}
	
	void PrintLL(){
		Node* temp = head;
		
		while(temp != NULL){
			cout << temp->data << " ";
			temp = temp->next;
		}
		cout << endl;
	}
};

void merge_list(Node* head1, Node* head2) {
		
		if ( head1 == nullptr ) {
			head1 = head2;
			return;
		}
		
		Node* temp = head1; 
		while( temp->next != nullptr ) {
			temp = temp->next;
		}
		temp->next = head2;
}

void sort_mergedList(Node* head) {
	Node* temp = head; 
	
	while( temp != nullptr ) {
		Node* current = temp->next;
		
		while( current != nullptr ) {
			if(temp->data > current->data){
				int data = temp->data;
				temp->data = current->data;
				current->data = data;
			}
			current = current->next;
		}
		temp = temp->next;
	}
}
	
 
int main(){
	List l1 , l2;
	l1.push_back(10);
	l1.push_back(20);
	l1.push_back(30);
	l1.push_back(40);
	l2.push_back(50);
	l2.push_back(60);
	l2.push_back(70);
	l2.push_back(80);
    merge_list(l1.head , l2.head);
    l1.PrintLL();
    l1.pop_middle(1);
	l1.PrintLL();
	
	return 0;
}
