#include<iostream>
#include<vector>
using namespace std;

int main(){
	int row , col;
	cout << "Input Number of Rows and Columns(respectively) : " << endl;
	cin >> row >> col;
	
	vector<vector<int>> matrix(row, vector<int>(col , 0)); 
	
	cout << "Enter elements of 2D Array : " << endl;
	for(int i = 0 ; i < row ; i++){
		for(int j = 0 ; j < col ; j++){
			cin >> matrix[i][j] ;
		}
	}
	
	int array[row*col];
	int index = 0;
	
	for(int j = 0 ; j < col ; j++){
		for(int i = 0 ; i < row ; i++){
			array[index] = matrix[i][j];
			index++;
		}
	}
	
	cout << "1D Array : " << endl;
	for(int i = 0 ; i < (row*col); i++){
		cout << array[i] << " ";
	}
	
	
	return 0;
}
